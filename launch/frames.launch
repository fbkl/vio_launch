<?xml version="1.0" encoding="UTF-8"?> 
<launch>
	<arg name="adj_cam" default="false"/>
	<arg name="camera"     default="camera0"/>
	
	<arg name="tf_imu_frame" value="imu/$(arg camera)"  />
	
	<include file="$(find vio_launch)/launch/includes/machines.xml"/>

	<group ns="$(arg camera)">

		<group if="$(arg adj_cam)">
			<node machine="main_pc" pkg="ar_test" type="adjustable_node" name="imu_is_$(arg camera)_link" >
				<param name="parent_frame_id"  	value="$(arg tf_imu_frame)"/>
				<param name="child_frame_id" 		value="$(arg camera)_parent"/>
				<param name="x" 		value="0"/>
				<param name="y" 		value="0"/>
				<param name="z" 		value="0"/>
				<param name="qx" 		value="0.5"/>
				<param name="qy" 		value="0.5"/>
				<param name="qz" 		value="-0.5"/>
				<param name="qw" 		value="0.5"/>
			</node>
		</group>
		<node pkg="tf2_ros" type="static_transform_publisher" name="$(arg camera)_is_baselink" args="0 0 0  0.5 -0.5 0.5 0.5 $(arg tf_imu_frame) $(arg camera)_parent" unless="$(arg adj_cam)"/>


	</group>
</launch>
