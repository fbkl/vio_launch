<?xml version="1.0" encoding="UTF-8"?> 
<launch>
	<arg name="camera"     default="camera0"/>
	<arg name="machine" 		default=""/>
	<arg name="visualize" 		default="true"/>
	<arg name="adj_map" default="true"/>
	<arg name="adj_map_frame" default="adj_map"/>
	
	<arg name="tf_imu_frame" value="imu/$(arg camera)"  />
	
	<include file="$(find vio_launch)/launch/includes/machines.xml"/>

	<!-- ros why do you have to be like this?-->
	<arg name="remote_vio_path" default="/home/frederico/pervio_ws/src/vio_launch" />
	<group ns="$(arg camera)">
		<!-- the log to the screen via ssh is flaky, file is better-->
		<node pkg="rovio" type="rovio_node" name="rovio" machine="$(arg machine)" if="$(eval arg('machine') != '')" required="true">
			<param name="filter_config" value="$(arg remote_vio_path)/config/rs_435i_filter.info" if="$(arg visualize)" />
			<param name="filter_config" value="$(arg remote_vio_path)/config/rs_435i_filter_no_vis.info" unless="$(arg visualize)" />
			<param name="camera0_config" value="$(arg remote_vio_path)/config/rs_435i_0.yaml"/>
			<param name="camera1_config" value="$(arg remote_vio_path)/config/rs_435i_1.yaml"/>
			<param name="map_frame" 	value="$(arg adj_map_frame)" if="$(arg adj_map)" />
			<param name="world_frame" 	value="$(arg adj_map_frame)" if="$(arg adj_map)" />
			<param name="map_frame" 	value="map"   	unless="$(arg adj_map)" />
			<param name="world_frame" 	value="map" 	unless="$(arg adj_map)" />
			<param name="camera_frame" 	value="$(arg camera)/camera"  />
			<param name="imu_frame" 	value="$(arg tf_imu_frame)"  />
			<!-- param name="world_frame" value="map"/ -->
		</node>
		<node pkg="rovio" type="rovio_node" name="rovio" output="screen" if="$(eval arg('machine') == '' )" required="true">
			<param name="filter_config" value="$(arg remote_vio_path)/config/rs_435i_filter.info" if="$(arg visualize)" />
			<param name="filter_config" value="$(arg remote_vio_path)/config/rs_435i_filter_no_vis.info" unless="$(arg visualize)" />
			<param name="camera0_config" value="$(arg remote_vio_path)/config/rs_435i_0.yaml"/>
			<param name="camera1_config" value="$(arg remote_vio_path)/config/rs_435i_1.yaml"/>
			<param name="map_frame" 	value="$(arg adj_map_frame)" if="$(arg adj_map)" />
			<param name="world_frame" 	value="$(arg adj_map_frame)" if="$(arg adj_map)" />
			<param name="map_frame" 	value="map"   	unless="$(arg adj_map)" />
			<param name="world_frame" 	value="map" 	unless="$(arg adj_map)" />
			<param name="camera_frame" 	value="$(arg camera)/camera"  />
			<param name="imu_frame" 	value="$(arg tf_imu_frame)"  />
			<!-- param name="world_frame" value="map"/ -->
		</node>

	</group>
</launch>
